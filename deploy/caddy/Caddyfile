{
	# Where certificates come from (CADDY_TLS in .env):
	#   cloudflare — Let's Encrypt via the Cloudflare DNS challenge: publicly
	#                trusted on every device, nothing exposed to the internet.
	#   internal   — Caddy's own local CA; each device trusts its root once.
	import tls-{$CADDY_TLS:internal}.caddy
}

# Response headers for both sites. "defer" applies them after the upstream
# answered: Strict-Transport-Security and nosniff replace any upstream value;
# Referrer-Policy ("?") only fills in when the upstream sent none, so Keycloak
# keeps its own no-referrer. The CSP is added next to whatever the upstream
# sends (browsers enforce every CSP header), so Keycloak keeps its own policy.
# It deliberately holds only frame-ancestors: nothing here restricts what pages
# load or frame (the app renders model-written demos in sandboxed iframes).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		+Content-Security-Policy "frame-ancestors 'self'"
		defer
	}
}

# The app — every request is authorized by oauth2-proxy (Keycloak login,
# group "learnharness") before it reaches LearnHarness.
{$LH_HOST} {
	import security_headers

	# Identity headers come ONLY from oauth2-proxy via forward_auth below.
	# Strip any a client sends first, on every path (the public @pwa routes
	# included). request_header sorts before handle, so this runs ahead of
	# every handle block.
	request_header -X-Auth-Request-*

	# oauth2-proxy's own endpoints: sign-in, callback, sign-out.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	# Browsers fetch the web manifest and its icons WITHOUT cookies, so the
	# PWA install would fail behind the login. The service worker and its
	# offline page are public too, so app updates never depend on the login
	# state. None of these are sensitive.
	# GET and HEAD only: any other method on these paths falls through to the
	# authenticated handle below.
	@pwa {
		method GET HEAD
		path /manifest.webmanifest /icons/* /icon.svg /apple-icon.png /sw.js /offline.html
	}
	handle @pwa {
		reverse_proxy learnharness:3000
	}

	# The API answers 401 (no login redirect) once the session has ended: a
	# redirect is useless to fetch()/EventSource, a 401 lets the app show its
	# "signed out" screen (components/session-watch.tsx).
	handle /api/* {
		# Uploads: the app takes one file per request, at most 250 MiB plus a
		# small multipart envelope (src/core/upload-limits.ts). 280 MB (decimal)
		# is a little above that; anything bigger is refused here, before it
		# reaches the app.
		request_body {
			max_size 280MB
		}
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Preferred-Username X-Auth-Request-Groups
		}
		reverse_proxy learnharness:3000 {
			flush_interval -1
		}
	}

	# Pages: an ended session redirects to the login.
	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Preferred-Username X-Auth-Request-Groups
			@unauthorized status 401
			handle_response @unauthorized {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}
		# flush_interval -1: stream SSE (live events, chat turns) unbuffered.
		reverse_proxy learnharness:3000 {
			flush_interval -1
		}
	}
}

# Keycloak — login pages and the admin console (/admin).
{$AUTH_SITE} {
	import security_headers

	reverse_proxy keycloak:8080
}
