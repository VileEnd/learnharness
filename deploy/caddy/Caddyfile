{
	# Where certificates come from (CADDY_TLS in .env):
	#   cloudflare — Let's Encrypt via the Cloudflare DNS challenge: publicly
	#                trusted on every device, nothing exposed to the internet.
	#   internal   — Caddy's own local CA; each device trusts its root once.
	import tls-{$CADDY_TLS:internal}.caddy
}

# The app — every request is authorized by oauth2-proxy (Keycloak login,
# group "learnharness") before it reaches LearnHarness.
{$LH_HOST} {
	# oauth2-proxy's own endpoints: sign-in, callback, sign-out.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	# Browsers fetch the web manifest and its icons WITHOUT cookies, so the
	# PWA install would fail behind the login. The service worker and its
	# offline page are public too, so app updates never depend on the login
	# state. None of these are sensitive.
	@pwa path /manifest.webmanifest /icons/* /icon.svg /apple-icon.png /sw.js /offline.html
	handle @pwa {
		reverse_proxy learnharness:3000
	}

	# The API answers 401 (no login redirect) once the session has ended: a
	# redirect is useless to fetch()/EventSource, a 401 lets the app show its
	# "signed out" screen (components/session-watch.tsx).
	handle /api/* {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email
		}
		reverse_proxy learnharness:3000 {
			flush_interval -1
		}
	}

	# Pages: an ended session redirects to the login.
	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email
			@unauthorized status 401
			handle_response @unauthorized {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}
		# flush_interval -1: stream SSE (live events, chat turns) unbuffered.
		reverse_proxy learnharness:3000 {
			flush_interval -1
		}
	}
}

# Keycloak — login pages and the admin console (/admin).
{$AUTH_SITE} {
	reverse_proxy keycloak:8080
}
