{
	# Home network only: every certificate comes from Caddy's own local CA
	# (volumes/caddy/data/caddy/pki/authorities/local/root.crt). Trust that
	# root once per device (docs/self-hosting.md).
	local_certs
}

# The app — every request is authorized by oauth2-proxy (Keycloak login,
# group "learnharness") before it reaches LearnHarness.
{$LH_HOST} {
	# oauth2-proxy's own endpoints: sign-in, callback, sign-out.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	# Browsers fetch the web manifest and its icons WITHOUT cookies, so the
	# PWA install would fail behind the login. They are not sensitive.
	@pwa path /manifest.webmanifest /icons/* /icon.svg /apple-icon.png
	handle @pwa {
		reverse_proxy learnharness:3000
	}

	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email
			@unauthorized status 401
			handle_response @unauthorized {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}
		# flush_interval -1: stream SSE (live events, chat turns) unbuffered.
		reverse_proxy learnharness:3000 {
			flush_interval -1
		}
	}
}

# Keycloak — login pages and the admin console (/admin).
{$AUTH_SITE} {
	reverse_proxy keycloak:8080
}
