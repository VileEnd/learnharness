# Copy to .env and fill in every value (docs/self-hosting.md).

# ── Hostnames ──────────────────────────────────────────────────────────────
# Until the UniFi move day: the FRITZ!Box names the VM "learnharness", so
# both the app and Keycloak use learnharness.fritz.box (Keycloak on :8443).
LH_HOST=learnharness.fritz.box
AUTH_SITE=learnharness.fritz.box:8443
AUTH_URL=https://learnharness.fritz.box:8443

# After the move day (UniFi DNS records → the VM), switch to:
# LH_HOST=learnharness.home.arpa
# AUTH_SITE=auth.home.arpa
# AUTH_URL=https://auth.home.arpa

# ── Secrets (generate, never commit .env) ──────────────────────────────────
# Keycloak admin console login (https://<AUTH_SITE>/admin).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
# Keycloak's database.            openssl rand -hex 24
POSTGRES_PASSWORD=
# The OIDC client secret.         openssl rand -hex 32
OIDC_CLIENT_SECRET=
# oauth2-proxy cookie encryption. openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
